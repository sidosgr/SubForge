{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubForge",
  "version": "0.1.12",
  "identifier": "gr.sidos.subforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SubForge",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sidos",
    "copyright": "Sidos - info@sidos.gr",
    "shortDescription": "Create and translate subtitles",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/": "bin/",
      "resources/licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Greek",
          "Spanish",
          "French",
          "German",
          "Portuguese",
          "Italian",
          "SimpChinese",
          "Korean",
          "Japanese"
        ],
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "customLanguageFiles": {
          "Greek": "installer-Greek.nsh"
        }
      }
    }
  }
}
